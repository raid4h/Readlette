# --------------------------------------------------------------------------
# Copy this file to .env.local (for local dev) and fill in real values.
# On Vercel, you'll set these in Project Settings -> Environment Variables
# instead (the Postgres ones get filled in AUTOMATICALLY when you create a
# Vercel Postgres database - see README "Step 2").
#
# NEVER put real secrets in THIS file - it's meant to be committed to git
# and is visible to anyone who can see the repo. Real values belong in
# .env.local, which should be listed in .gitignore.
# --------------------------------------------------------------------------

# Your Goodreads numeric user ID, e.g. if your profile URL is
# goodreads.com/user/show/12345678-jane-doe, your ID is 12345678
GOODREADS_USER_ID=your_goodreads_user_id_here

# Auto-filled by Vercel when you connect a Neon Postgres database (via the
# Vercel Marketplace - see README Step 2). For local development, paste the
# connection string shown in Vercel's Storage tab into .env.local, NOT here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel sets this automatically for Cron Jobs - you don't need to set it
# yourself on Vercel. Only fill this in locally if you want to test the
# /api/sync-rss route the same way the cron job calls it.
CRON_SECRET=